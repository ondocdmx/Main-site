# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# Signing secret del webhook (Stripe → Developers → Webhooks, o el que imprime `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Hoja "Pedidos" (Apps Script, docs/apps-script/pedidos.gs; ver docs/checkout.md §4) ──
ORDERS_WEBHOOK_URL=
ORDERS_WEBHOOK_TOKEN=

# ── Servidor Express (opcional, default: http://localhost:3000) ───────────────
FRONTEND_URL=http://localhost:3000
PORT=3001

# ── Google Sheets (Apps Script) ───────────────────────────────────────────────
# Formulario "¿Qué sopa amas más?" y leads de zona de reparto
GOOGLE_SHEETS_WEBHOOK_URL=
# Opcional: hoja aparte para los leads de zona de reparto
GOOGLE_SHEETS_DELIVERY_WEBHOOK_URL=
