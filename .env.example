# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...

# ── Servidor Express (opcional, default: http://localhost:3000) ───────────────
FRONTEND_URL=http://localhost:3000
PORT=3001

# ── Sanity (ya configurado en sanityClient.ts) ────────────────────────────────
VITE_SANITY_WRITE_TOKEN=

# ── GA4 (opcional: activa gtag.js y el envío de eventos a Google Analytics) ───
# GA4 → Admin → Flujos de datos → Web → ID de medición (G-...)
VITE_GA4_ID=

# ── Otros ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
