{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/sopas", "destination": "/tienda", "permanent": true },
    { "source": "/sopas/", "destination": "/tienda", "permanent": true }
  ],
  "rewrites": [
    { "source": "/tienda", "destination": "/tienda/index.html" },
    { "source": "/sopas/:path*", "destination": "/index.html" },
    { "source": "/soupscripciones", "destination": "/index.html" }
  ]
}
